# Content Intelligence Platform — Environment Variables
# Copy to .env and fill in your values

# ──────────────────────────────────────────────
# Server Configuration
# ──────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ──────────────────────────────────────────────
# PRIMARY AI PROVIDER — GitHub Models (FREE)
# Get token: https://github.com/settings/tokens
# Required for ai-content-generator, github-models.service.ts
# ──────────────────────────────────────────────
GITHUB_TOKEN=your_github_token_here

# ──────────────────────────────────────────────
# OpenAI API — Real Video/Audio Transcription (Whisper)
# Get key: https://platform.openai.com/api-keys
# When set, videos are ACTUALLY transcribed instead of using templates
# ──────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here

# ──────────────────────────────────────────────
# AWS Configuration (OPTIONAL — Bedrock + S3)
# Official AWS SDK reads credentials from these environment variables.
# Do NOT hardcode credentials in code.
# ──────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=ai-bharat-file-storage
AWS_DYNAMODB_TABLE_PREFIX=content-platform
AWS_SQS_QUEUE_URL=https://sqs.eu-north-1.amazonaws.com/337480111372/content-platform-processing-queue
AWS_CLOUDFRONT_DISTRIBUTION_ID=E19M2TGRM7BTCS
CLOUDFRONT_DOMAIN=d201u6s8w7hw5p.cloudfront.net
DYNAMODB_TABLE=content-intelligence-cache

# ──────────────────────────────────────────────
# FALLBACK A — Google Gemini API
# npm install @google/generative-ai
# Used if GITHUB_TOKEN and AWS credentials are both unavailable
# ──────────────────────────────────────────────
# GOOGLE_AI_API_KEY=your_gemini_api_key_here

# ──────────────────────────────────────────────
# FALLBACK B — Full Mock Mode (no external AI needed)
# Set MOCK_MODE=true to return realistic hardcoded demo data
# Perfect for prototype demos without any API keys
# ──────────────────────────────────────────────
# MOCK_MODE=true

# ──────────────────────────────────────────────
# Security
# ──────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
JWT_SECRET=your_jwt_secret_here_change_in_production

# ──────────────────────────────────────────────
# Rate Limiting
# ──────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
UPLOAD_RATE_LIMIT_MAX=10

# ──────────────────────────────────────────────
# File Upload
# ──────────────────────────────────────────────
MAX_FILE_SIZE=104857600
ALLOWED_FILE_TYPES=video/mp4,video/quicktime,audio/mpeg,audio/wav,text/plain

# ──────────────────────────────────────────────
# Cache
# ──────────────────────────────────────────────
CACHE_TTL_SECONDS=3600

# ──────────────────────────────────────────────
# Logging
# ──────────────────────────────────────────────
LOG_LEVEL=info
