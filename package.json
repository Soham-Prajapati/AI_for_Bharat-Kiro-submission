{
  "name": "content-intelligence-platform",
  "version": "1.0.0",
  "description": "AI-assisted content understanding and generation system",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:services": "ts-node src/test-services.ts",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "demo": "ts-node src/demo.ts",
    "lint": "eslint src --ext .ts",
    "load-test": "node -e \"console.log('Use: npm run load-test:all, load-test:upload, load-test:generation, load-test:ratelimit, or load-test:stress')\"",
    "load-test:all": "k6 run --env BASE_URL=http://localhost:3000 load-tests/scenarios/upload-load.js && k6 run --env BASE_URL=http://localhost:3000 load-tests/scenarios/content-generation-load.js && k6 run --env BASE_URL=http://localhost:3000 load-tests/scenarios/rate-limit-test.js && k6 run --env BASE_URL=http://localhost:3000 load-tests/scenarios/stress-test.js",
    "load-test:upload": "k6 run --env BASE_URL=http://localhost:3000 load-tests/scenarios/upload-load.js",
    "load-test:generation": "k6 run --env BASE_URL=http://localhost:3000 load-tests/scenarios/content-generation-load.js",
    "load-test:ratelimit": "k6 run --env BASE_URL=http://localhost:3000 load-tests/scenarios/rate-limit-test.js",
    "load-test:stress": "k6 run --env BASE_URL=http://localhost:3000 load-tests/scenarios/stress-test.js",
    "load-test:report": "node scripts/generate-load-test-report.js local"
  },
  "keywords": [
    "ai",
    "content",
    "aws",
    "bedrock"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.0",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.0.0",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "fast-check": "^3.15.0",
    "jest": "^29.5.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.490.0",
    "@aws-sdk/client-s3": "^3.490.0",
    "@aws-sdk/client-transcribe": "^3.490.0",
    "@aws-sdk/s3-request-presigner": "^3.490.0",
    "@types/jsonwebtoken": "^9.0.10",
    "axios": "^1.13.5",
    "cors": "^2.8.5",
    "dotenv": "^16.3.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "uuid": "^13.0.0",
    "winston": "^3.19.0",
    "ws": "^8.19.0",
    "zod": "^4.3.6"
  }
}
