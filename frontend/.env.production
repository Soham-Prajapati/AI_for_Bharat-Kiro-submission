# Production Environment Variables for Vercel Deployment
# DO NOT commit this file with actual values - use Vercel Environment Variables instead

# Backend API URL (REQUIRED)
# Set this in Vercel Dashboard: Settings > Environment Variables
# Example: https://api.yourdomain.com or https://your-ec2-instance.compute.amazonaws.com:3000
NEXT_PUBLIC_API_URL=

# Optional: Analytics & Monitoring
# NEXT_PUBLIC_ANALYTICS_ID=
# NEXT_PUBLIC_SENTRY_DSN=

# Optional: Feature Flags
# NEXT_PUBLIC_ENABLE_ANALYTICS=true
# NEXT_PUBLIC_ENABLE_COMMUNITY=true
# NEXT_PUBLIC_ENABLE_MARKETPLACE=true

# Optional: Third-party Integrations
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
# NEXT_PUBLIC_MIXPANEL_TOKEN=

# Build-time Variables (if needed)
# ANALYZE=false
