{
  "alarms": [
    {
      "AlarmName": "HighErrorRate-CRITICAL",
      "AlarmDescription": "Error rate exceeds 5% - immediate attention required",
      "MetricName": "5XXError",
      "Namespace": "AWS/ApiGateway",
      "Statistic": "Sum",
      "Period": 300,
      "EvaluationPeriods": 2,
      "Threshold": 5.0,
      "ComparisonOperator": "GreaterThanThreshold",
      "TreatMissingData": "notBreaching",
      "AlarmActions": ["arn:aws:sns:us-east-1:ACCOUNT_ID:critical-alerts"],
      "Severity": "CRITICAL"
    },
    {
      "AlarmName": "HighAPILatency-WARNING",
      "AlarmDescription": "API P95 latency exceeds 2 seconds",
      "MetricName": "Latency",
      "Namespace": "AWS/ApiGateway",
      "ExtendedStatistic": "p95",
      "Period": 300,
      "EvaluationPeriods": 2,
      "Threshold": 2000,
      "ComparisonOperator": "GreaterThanThreshold",
      "TreatMissingData": "notBreaching",
      "AlarmActions": ["arn:aws:sns:us-east-1:ACCOUNT_ID:warning-alerts"],
      "Severity": "WARNING"
    },
    {
      "AlarmName": "HighCPUUtilization-WARNING",
      "AlarmDescription": "CPU utilization above 80% for 5 minutes",
      "MetricName": "CPUUtilization",
      "Namespace": "AWS/ECS",
      "Statistic": "Average",
      "Period": 300,
      "EvaluationPeriods": 1,
      "Threshold": 80.0,
      "ComparisonOperator": "GreaterThanThreshold",
      "TreatMissingData": "notBreaching",
      "AlarmActions": ["arn:aws:sns:us-east-1:ACCOUNT_ID:warning-alerts"],
      "Severity": "WARNING"
    },
    {
      "AlarmName": "HighMemoryUtilization-WARNING",
      "AlarmDescription": "Memory utilization above 85%",
      "MetricName": "MemoryUtilization",
      "Namespace": "AWS/ECS",
      "Statistic": "Average",
      "Period": 300,
      "EvaluationPeriods": 2,
      "Threshold": 85.0,
      "ComparisonOperator": "GreaterThanThreshold",
      "TreatMissingData": "notBreaching",
      "AlarmActions": ["arn:aws:sns:us-east-1:ACCOUNT_ID:warning-alerts"],
      "Severity": "WARNING"
    },
    {
      "AlarmName": "BedrockHighFailureRate-CRITICAL",
      "AlarmDescription": "Bedrock API call failures exceed 10%",
      "MetricName": "InvocationServerErrors",
      "Namespace": "AWS/Bedrock",
      "Statistic": "Sum",
      "Period": 300,
      "EvaluationPeriods": 2,
      "Threshold": 10.0,
      "ComparisonOperator": "GreaterThanThreshold",
      "TreatMissingData": "notBreaching",
      "AlarmActions": ["arn:aws:sns:us-east-1:ACCOUNT_ID:critical-alerts"],
      "Severity": "CRITICAL"
    },
    {
      "AlarmName": "S3UploadFailures-WARNING",
      "AlarmDescription": "S3 upload failures exceed 5%",
      "MetricName": "5xxErrors",
      "Namespace": "AWS/S3",
      "Statistic": "Sum",
      "Period": 300,
      "EvaluationPeriods": 2,
      "Threshold": 5.0,
      "ComparisonOperator": "GreaterThanThreshold",
      "TreatMissingData": "notBreaching",
      "AlarmActions": ["arn:aws:sns:us-east-1:ACCOUNT_ID:warning-alerts"],
      "Severity": "WARNING"
    },
    {
      "AlarmName": "DatabaseConnectionsHigh-WARNING",
      "AlarmDescription": "Database connections approaching limit",
      "MetricName": "DatabaseConnections",
      "Namespace": "AWS/RDS",
      "Statistic": "Average",
      "Period": 300,
      "EvaluationPeriods": 2,
      "Threshold": 80,
      "ComparisonOperator": "GreaterThanThreshold",
      "TreatMissingData": "notBreaching",
      "AlarmActions": ["arn:aws:sns:us-east-1:ACCOUNT_ID:warning-alerts"],
      "Severity": "WARNING"
    },
    {
      "AlarmName": "LambdaThrottling-WARNING",
      "AlarmDescription": "Lambda functions being throttled",
      "MetricName": "Throttles",
      "Namespace": "AWS/Lambda",
      "Statistic": "Sum",
      "Period": 300,
      "EvaluationPeriods": 1,
      "Threshold": 10,
      "ComparisonOperator": "GreaterThanThreshold",
      "TreatMissingData": "notBreaching",
      "AlarmActions": ["arn:aws:sns:us-east-1:ACCOUNT_ID:warning-alerts"],
      "Severity": "WARNING"
    },
    {
      "AlarmName": "DiskSpaceHigh-WARNING",
      "AlarmDescription": "Disk space utilization above 80%",
      "MetricName": "FreeStorageSpace",
      "Namespace": "AWS/RDS",
      "Statistic": "Average",
      "Period": 300,
      "EvaluationPeriods": 2,
      "Threshold": 20,
      "ComparisonOperator": "LessThanThreshold",
      "TreatMissingData": "notBreaching",
      "AlarmActions": ["arn:aws:sns:us-east-1:ACCOUNT_ID:warning-alerts"],
      "Severity": "WARNING",
      "Unit": "Percent"
    },
    {
      "AlarmName": "HealthCheckFailures-CRITICAL",
      "AlarmDescription": "Health check failures detected",
      "MetricName": "UnHealthyHostCount",
      "Namespace": "AWS/ApplicationELB",
      "Statistic": "Average",
      "Period": 60,
      "EvaluationPeriods": 2,
      "Threshold": 1,
      "ComparisonOperator": "GreaterThanOrEqualToThreshold",
      "TreatMissingData": "notBreaching",
      "AlarmActions": ["arn:aws:sns:us-east-1:ACCOUNT_ID:critical-alerts"],
      "Severity": "CRITICAL"
    }
  ]
}
