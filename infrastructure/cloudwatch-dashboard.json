{
  "dashboardName": "ContentCreatorPlatform-Production",
  "dashboardBody": {
    "widgets": [
      {
        "type": "metric",
        "properties": {
          "metrics": [
            ["AWS/ApiGateway", "Latency", { "stat": "p50", "label": "P50 Latency" }],
            ["...", { "stat": "p95", "label": "P95 Latency" }],
            ["...", { "stat": "p99", "label": "P99 Latency" }]
          ],
          "period": 300,
          "stat": "Average",
          "region": "us-east-1",
          "title": "API Latency (ms)",
          "yAxis": {
            "left": {
              "min": 0
            }
          }
        }
      },
      {
        "type": "metric",
        "properties": {
          "metrics": [
            ["AWS/ApiGateway", "5XXError", { "stat": "Sum", "label": "5XX Errors" }],
            [".", "4XXError", { "stat": "Sum", "label": "4XX Errors" }],
            [".", "Count", { "stat": "Sum", "label": "Total Requests" }]
          ],
          "period": 300,
          "stat": "Sum",
          "region": "us-east-1",
          "title": "Error Rate Tracking",
          "yAxis": {
            "left": {
              "min": 0
            }
          }
        }
      },
      {
        "type": "metric",
        "properties": {
          "metrics": [
            ["AWS/ApiGateway", "Count", { "stat": "Sum", "label": "Requests/min" }]
          ],
          "period": 60,
          "stat": "Sum",
          "region": "us-east-1",
          "title": "Request Throughput",
          "yAxis": {
            "left": {
              "min": 0
            }
          }
        }
      },
      {
        "type": "metric",
        "properties": {
          "metrics": [
            ["AWS/ECS", "CPUUtilization", { "stat": "Average", "label": "CPU %" }],
            [".", "MemoryUtilization", { "stat": "Average", "label": "Memory %" }]
          ],
          "period": 300,
          "stat": "Average",
          "region": "us-east-1",
          "title": "CPU and Memory Utilization",
          "yAxis": {
            "left": {
              "min": 0,
              "max": 100
            }
          }
        }
      },
      {
        "type": "metric",
        "properties": {
          "metrics": [
            ["AWS/RDS", "DatabaseConnections", { "stat": "Average", "label": "Connections" }],
            [".", "ReadLatency", { "stat": "Average", "label": "Read Latency (ms)" }],
            [".", "WriteLatency", { "stat": "Average", "label": "Write Latency (ms)" }]
          ],
          "period": 300,
          "stat": "Average",
          "region": "us-east-1",
          "title": "Database Query Performance",
          "yAxis": {
            "left": {
              "min": 0
            }
          }
        }
      },
      {
        "type": "metric",
        "properties": {
          "metrics": [
            ["AWS/S3", "AllRequests", { "stat": "Sum", "label": "Total Requests" }],
            [".", "PutRequests", { "stat": "Sum", "label": "Uploads" }],
            [".", "GetRequests", { "stat": "Sum", "label": "Downloads" }],
            [".", "4xxErrors", { "stat": "Sum", "label": "4XX Errors" }],
            [".", "5xxErrors", { "stat": "Sum", "label": "5XX Errors" }]
          ],
          "period": 300,
          "stat": "Sum",
          "region": "us-east-1",
          "title": "S3 Upload/Download Metrics",
          "yAxis": {
            "left": {
              "min": 0
            }
          }
        }
      },
      {
        "type": "metric",
        "properties": {
          "metrics": [
            ["AWS/Bedrock", "Invocations", { "stat": "Sum", "label": "Total Calls" }],
            [".", "InvocationClientErrors", { "stat": "Sum", "label": "Client Errors" }],
            [".", "InvocationServerErrors", { "stat": "Sum", "label": "Server Errors" }],
            [".", "InvocationLatency", { "stat": "Average", "label": "Latency (ms)" }]
          ],
          "period": 300,
          "stat": "Average",
          "region": "us-east-1",
          "title": "Bedrock API Call Metrics",
          "yAxis": {
            "left": {
              "min": 0
            }
          }
        }
      },
      {
        "type": "metric",
        "properties": {
          "metrics": [
            ["ContentCreatorPlatform", "ActiveSessions", { "stat": "Average", "label": "Active Users" }],
            [".", "NewSessions", { "stat": "Sum", "label": "New Sessions" }],
            [".", "SessionDuration", { "stat": "Average", "label": "Avg Duration (min)" }]
          ],
          "period": 300,
          "stat": "Average",
          "region": "us-east-1",
          "title": "Active User Sessions",
          "yAxis": {
            "left": {
              "min": 0
            }
          }
        }
      },
      {
        "type": "log",
        "properties": {
          "query": "SOURCE '/aws/lambda/content-generator'\n| fields @timestamp, @message\n| filter @message like /ERROR/\n| sort @timestamp desc\n| limit 20",
          "region": "us-east-1",
          "title": "Recent Errors",
          "stacked": false
        }
      },
      {
        "type": "metric",
        "properties": {
          "metrics": [
            ["AWS/Lambda", "Invocations", { "stat": "Sum", "label": "Invocations" }],
            [".", "Errors", { "stat": "Sum", "label": "Errors" }],
            [".", "Throttles", { "stat": "Sum", "label": "Throttles" }],
            [".", "Duration", { "stat": "Average", "label": "Duration (ms)" }]
          ],
          "period": 300,
          "stat": "Average",
          "region": "us-east-1",
          "title": "Lambda Performance",
          "yAxis": {
            "left": {
              "min": 0
            }
          }
        }
      }
    ]
  }
}
